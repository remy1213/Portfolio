# Review storage (needed for the live site; local dev works without it).
#
# 1. In Vercel: your project -> Storage -> Create Database -> Upstash Redis
#    (free plan) -> Connect to project. Vercel adds these vars to the
#    deployment automatically — nothing to copy for production.
# 2. For your LOCAL admin to moderate the live site's reviews, copy the two
#    values from Vercel (Project -> Settings -> Environment Variables) or
#    from console.upstash.com into a file named ".env.local" next to this
#    one, then restart "npm run dev".
#
# Vercel may name them KV_REST_API_URL / KV_REST_API_TOKEN instead — both
# names work.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
